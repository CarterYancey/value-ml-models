{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && \"${VML_PYTHON:-.venv/bin/python}\" scripts/hooks/writing_hook.py",
            "timeout": 60,
            "statusMessage": "Checking the reply against the writing rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && \"${VML_PYTHON:-.venv/bin/python}\" scripts/hooks/writing_hook.py",
            "timeout": 60,
            "statusMessage": "Checking the written text against the writing rules"
          }
        ]
      }
    ]
  }
}
